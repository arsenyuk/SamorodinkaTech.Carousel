# H6: copy to .env and fill in real values. .env is gitignored.

# PostgreSQL (docker-compose)
POSTGRES_PASSWORD=change-me

# Application — required in Production
ConnectionStrings__Carousel=Host=localhost;Port=5432;Database=carousel;Username=carousel;Password=change-me
Auth__Jwt__SigningKey=change-me-32-bytes-minimum-key!!

# Telegram (optional in dev; required for real bot)
Telegram__BotToken=

# Set to true in Production if you want app to run migrations on startup
# (recommended: false — run migrations as a separate one-off job)
# Database__AutoMigrate=false
