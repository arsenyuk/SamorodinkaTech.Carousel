{
  "ConnectionStrings": {
    // H6: dev-only default. Production MUST override via env: ConnectionStrings__Carousel
    "Carousel": "Host=localhost;Port=5432;Database=carousel;Username=carousel;Password=carousel"
  },
  "Database": {
    // H6: авто-миграция при старте. По правилу AGENTS: Production — ВСЕГДА false
    // (включение в проде только по команде пользователя). Development — в appsettings.Development.json.
    "AutoMigrate": false
  },
  "Auth": {
    "Jwt": {
      // Required in Production. Dev falls back to a well-known local key. Override via env: Auth__Jwt__SigningKey
      "SigningKey": ""
    },
    "AllowDevInitData": false
  },
  "Telegram": {
    // Override via env: Telegram__BotToken
    "BotToken": "",
    // Username бота для ссылок в историях/Mini App: пусто → getMe по токену.
    // Override via env: Telegram__BotUsername (тестовый/прод бот разводятся здесь или токеном).
    "BotUsername": "",
    "MiniAppUrl": "http://localhost:5173",
    "UseMock": false
  },
  "Instagram": {
    // Stage 4: true = in-process mock (default in Development); false = Meta Graph API.
    // Override via env: Instagram__UseMock, Instagram__AccessToken, Instagram__PublicMediaBaseUrl
    "UseMock": false,
    "GraphApiBaseUrl": "https://graph.facebook.com/v21.0",
    "AccessToken": "",
    "PublicMediaBaseUrl": "http://localhost:5050"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Billing": {
    // C3: webhooks disabled by default until Stage 5 adds signature verification
    "WebhooksEnabled": false,
    // Цена публикации в Telegram Stars: целое ≥1, иначе fail-fast при старте.
    "StarsPrice": "1",
    // Username, публикующих без оплаты (@ опционален, регистр не важен).
    // Пусто на проде; env: Billing__FreeUsernames__0=@username.
    "FreeUsernames": []
  },
  "Admin": {
    // Алиасы администраторов: доступ к /api/admin/* и странице «Статистика»
    // (@ опционален, регистр не важен). Пусто на проде; env: Admin:Usernames__0=username.
    "Usernames": []
  },
  "Cleanup": {
    // Retention-очистка (фоновый джоб): публикации старше N дней (каскадом карточки/доставки)
    // + осиротевшие media_assets старше M дней. Payments и audit_events НЕ трогаются.
    // env: Cleanup__Enabled=false / Cleanup__PublicationRetentionDays=180 / Cleanup__IntervalHours=24.
    "Enabled": true,
    "PublicationRetentionDays": 180,
    "OrphanMediaRetentionDays": 30,
    "IntervalHours": 24
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {ClientIp} {UserName} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/carousel-api-.log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {RequestId} {ClientIp} {UserName} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "MinimumLevel": "Information",
            "Override": {
              "Microsoft.AspNetCore": "Warning",
              "Microsoft.EntityFrameworkCore": "Warning"
            },
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "logs/audit-.log",
                  "rollingInterval": "Day",
                  "fileSizeLimitBytes": 104857600,
                  "rollOnFileSizeLimit": true,
                  "retainedFileCountLimit": 14,
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Message:lj}{NewLine}{Exception}"
                }
              }
            ],
            "Filter": [
              { "Name": "ByIncludingOnly", "Args": { "expression": "SourceContext = 'Audit'" } }
            ]
          }
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
